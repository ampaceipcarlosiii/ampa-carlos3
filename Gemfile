source "https://rubygems.org"

# El paquete "github-pages" instala exactamente las mismas versiones
# de Jekyll y plugins que usa GitHub Pages en sus servidores.
# Así, lo que veis en vuestro ordenador es igual a lo que se publica.
gem "github-pages", group: :jekyll_plugins

# Necesario en Windows/algunas instalaciones para las zonas horarias
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
